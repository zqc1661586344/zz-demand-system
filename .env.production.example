# ═══════════════════════════════════════════════════════════════════════
#  Enterprise RAG System — 生产环境配置模板
#
#  将此文件复制为 .env 并填入实际值。
#  ⚠ 所有标注 "必须修改" 的字段在启动前务必替换！
# ═══════════════════════════════════════════════════════════════════════

# ── 必须：运行环境 ────────────────────────────────────────────────────
ENVIRONMENT=production           # 必须设为 production，触发安全校验
APP_DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json                  # 推荐 JSON 格式，便于日志平台采集
LOG_FILE=./data/logs/app.log

# ── 必须：数据库 ──────────────────────────────────────────────────────
# PostgreSQL 连接串
DATABASE_URL=postgresql://user:pass@localhost:5432/ragdb
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true

# ── 必须：JWT 密钥 ────────────────────────────────────────────────────
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=must-replace-with-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LLM ───────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ── Embedding ─────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=sk-your-api-key
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# ── Chroma ────────────────────────────────────────────────────────────
CHROMA_COLLECTION_NAME=documents
CHROMA_PERSIST_DIR=./data/chroma

# ── 检索算法 ─────────────────────────────────────────────────────────
RAG_SEARCH_TYPE=hybrid
RAG_HYBRID_ALPHA=0.5
RAG_HYBRID_MIN_SPREAD=0.015
RAG_MIN_SCORE=0.4

# ── 必须：CORS ────────────────────────────────────────────────────────
# 不允许通配符；列出所有前端域名，逗号分隔
CORS_ORIGINS=https://app.example.com

# ── 限流 ──────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=30/minute
RATE_LIMIT_LLM_QUERY=10/minute
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_UPLOAD=5/minute

# ── 必须：任务队列 ────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:password@redis-host:6379/0
CELERY_RESULT_BACKEND=redis://:password@redis-host:6379/1
# BM25 缓存 TTL — 文档变更后其他 worker 最多 TTL 秒后自动感知
REDIS_BM25_CACHE_TTL_SECONDS=300

# ── 多进程部署 ───────────────────────────────────────────────────────
WEB_CONCURRENCY=4

# ── 上传 ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf,.txt,.md,.docx

# ── 文档分块 ─────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=150