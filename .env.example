# Database
DATABASE_URL=sqlite:///./data/app.db

# JWT
JWT_SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
# 设置token过期时间为1年
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=525600
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM Configuration
# For OpenAI-compatible API (supports OpenAI, DeepSeek, Tongyi Qianwen, Zhipu, etc.)
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# For local Ollama deployment (override above)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# Embedding
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=123
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# For local embedding
# EMBEDDING_PROVIDER=ollama
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Chroma
CHROMA_PERSIST_DIR=./data/chroma

# App
APP_NAME=Enterprise RAG System
APP_DEBUG=true
LOG_LEVEL=INFO