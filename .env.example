# ═══════════════════════════════════════════════════════════════════════
#  Enterprise RAG System — 环境配置模板
#
#  复制为 .env 并根据环境修改配置。
#  生产环境请务必设置 ENVIRONMENT=production，并覆盖默认密钥。
# ═══════════════════════════════════════════════════════════════════════

# ── 运行环境 ──────────────────────────────────────────────────────────
# development / production（production 模式下会强制校验安全配置）
ENVIRONMENT=development
APP_DEBUG=true
LOG_LEVEL=INFO
# plain（传统文本格式） / json（结构化 JSON，推荐生产环境）
LOG_FORMAT=plain
# 日志文件路径；留空则仅输出到 stdout
LOG_FILE=./data/logs/app.log

# ── 数据库 ────────────────────────────────────────────────────────────
# 开发环境：留空自动回退 SQLite；显式设置则用 PG 连接串
# DATABASE_URL=sqlite:///./data/app.db   # 或留空
# DATABASE_URL=postgresql://user:pass@localhost:5432/ragdb  # 生产 PostgreSQL
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true

# ── JWT ───────────────────────────────────────────────────────────────
# 生产环境必须改为随机字符串！
JWT_SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
# Token 过期时间（分钟）— 默认 30 分钟，可根据需求调整
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=525600
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LLM ───────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# For local Ollama deployment
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# ── Embedding ─────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=123
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_MODEL=bge-m3

# For local Ollama embedding
# EMBEDDING_PROVIDER=ollama
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── PGVector 向量数据库 ────────────────────────────────────────────────
# 指向你的 pgvector 容器（post01 库，密码中包含'@'符号' → URL 编码为'%40'）
VECTOR_STORE_URL=postgresql+psycopg://postgres:c1df689%40@localhost:5432/post01


# ── 任务队列（Celery + Redis） ────────────────────────────────────────
# 留空时回退 BackgroundTasks（开发模式）
# 生产环境示例：
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_BROKER_URL='redis://:c19%40@localhost:6379/0'
CELERY_RESULT_BACKEND='redis://:c19%40@localhost:6379/0'
# 即使redis配置存在，也关闭celery任务，使用BackgroundTasks；生产环境改为 true
USE_CELERY_TASK=false

# ── 检索算法 ─────────────────────────────────────────────────────────
# similarity / mmr / hybrid（默认）
RAG_SEARCH_TYPE=hybrid
# Hybrid RAG 稠密 vs 稀疏权重：0=纯BM25, 1=纯向量
RAG_HYBRID_ALPHA=0.5
# 稀疏检索后端：pg_tsvector（默认，PG 原生 tsvector+ts_rank+GIN，增量零内存）/ bm25_memory（进程内 BM25）
# 仅当 DATABASE_URL 指向 PostgreSQL 时 pg_tsvector 生效；SQLite 环境自动回退 bm25_memory
RAG_SPARSE_BACKEND=pg_tsvector
# 稠密分数离散度下限（防止无关 query 误召回）
RAG_HYBRID_MIN_SPREAD=0.015
# 相关性阈值（低于此值回退 free chat）
RAG_MIN_SCORE=0.4

# ── Rerank（交叉编码器重排） ─────────────────────────────────────────
RAG_RERANK_ENABLED=false
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_TOP_N=5

# ── BM25 缓存 ────────────────────────────────────────────────────────
# 多 worker 下绕过进程内缓存，每次都从 DB 重建（正确但较慢）
# 有 Redis 时会自动通过时间戳保持一致性，设为 false 即可
RAG_BM25_CACHE_BYPASS=false
# Redis BM25 时间戳 TTL（秒），仅当 celery_broker_url 配置时生效
REDIS_BM25_CACHE_TTL_SECONDS=300

# ── 文件上传 ─────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf,.txt,.md,.docx

# ── 文档分块 ─────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ── CORS ──────────────────────────────────────────────────────────────
# 开发环境通配符允许所有来源；生产环境必须明确指定
CORS_ORIGINS=*
# 生产环境示例：
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# ── 限流 ──────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=30/minute
RATE_LIMIT_LLM_QUERY=10/minute
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_UPLOAD=5/minute

# ── 多进程部署 ─────────────────────────────────────────────────────────
WEB_CONCURRENCY=4

